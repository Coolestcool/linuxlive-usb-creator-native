FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libegl1 libopengl0 libgl1 libxkbcommon0 libxkbcommon-x11-0 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-render-util0 libxcb-xinerama0 libxcb-randr0 libdbus-1-3 \
    libfontconfig1 libfreetype6 libglib2.0-0 libx11-xcb1 pkexec \
    fdisk dosfstools util-linux && rm -rf /var/lib/apt/lists/*
ENV QT_QPA_PLATFORM=offscreen LANG=C.UTF-8
